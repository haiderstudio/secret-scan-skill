 import json
 
+def load_tasks(path):
+    with open(path) as f:
+        return json.load(f)
+
+def count_done(tasks):
+    return sum(1 for t in tasks if t["done"])
+
+def main():
+    print(count_done(load_tasks("tasks.json")))
 if __name__ == "__main__":
     main()
